# LLM opcional (desligado por padrao). Qualquer provedor no formato /chat/completions serve: Groq e OpenRouter,
# por exemplo, trocam-se so por LLM_BASE_URL e LLM_MODEL. A chave fica so aqui, nunca em arquivo versionado.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Modelos alternativos, separados por virgula, tentados na ordem se o principal falhar (vazio = nenhum)
LLM_FALLBACK_MODELS=
# Agente em data/agents/<id>/ (persona, regras, fluxo e parametros versionados); vazio = triage-assistant
LLM_AGENT_ID=
LOG_LEVEL=INFO

# Identificacao do verificador de links (padrao: nome do projeto; nao imita navegador)
LINK_CHECK_USER_AGENT=

# Localizador de fontes por texto do pedido (limiares em [0, 1]; vazio usa o padrao: 0.25 e 0.15)
# FINDER_MIN_SCORE: pontuacao minima da melhor fonte; FINDER_MARGIN: folga minima para a segunda melhor
FINDER_MIN_SCORE=
FINDER_MARGIN=
